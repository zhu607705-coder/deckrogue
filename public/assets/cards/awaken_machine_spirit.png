<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f59e0b;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#1a1a2e;stop-opacity:0.8"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="256" height="256" fill="url(#bg)" rx="8"/>
  <rect x="8" y="8" width="240" height="240" fill="none" stroke="#f59e0b" stroke-width="2" rx="12" opacity="0.5"/>
  <text x="128" y="110" text-anchor="middle" font-family="serif" font-size="48" fill="#f59e0b" filter="url(#glow)">⚙</text>
  <text x="128" y="160" text-anchor="middle" font-family="sans-serif" font-size="14" fill="#a0a0a0">Awaken Machine Spirit</text>
  <text x="128" y="200" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#666">Mechanicus Power</text>
</svg>