<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#94a3b8;stop-opacity:0.4"/>
      <stop offset="100%" style="stop-color:#1a1a2e;stop-opacity:0.9"/>
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="256" height="256" fill="url(#bg)" rx="16"/>
  <rect x="8" y="8" width="240" height="240" fill="none" stroke="#94a3b8" stroke-width="2" rx="10.666666666666666" opacity="0.6"/>
  <text x="128" y="118" text-anchor="middle" font-family="serif" font-size="64" fill="#94a3b8" filter="url(#glow)">✨</text>
  <text x="128" y="179.2" text-anchor="middle" font-family="sans-serif" font-size="14.222222222222221" fill="#a0a0a0">Thick Skin</text>
  <text x="128" y="213.33333333333331" text-anchor="middle" font-family="sans-serif" font-size="10.666666666666666" fill="#666">Common</text>
</svg>