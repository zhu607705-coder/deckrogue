<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 768">
    
      <defs>
        <radialGradient id="chaosGrad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" style="stop-color:#a855f7;stop-opacity:0.4"/>
          <stop offset="100%" style="stop-color:#0a0a0f;stop-opacity:1"/>
        </radialGradient>
        <filter id="warp">
          <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="4" result="noise"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G"/>
        </filter>
      </defs>
      <rect width="1024" height="768" fill="#0a0a0f"/>
      <rect width="1024" height="768" fill="url(#chaosGrad)" filter="url(#warp)"/>
      <circle cx="512" cy="384" r="150" fill="none" stroke="#a855f7" stroke-width="2" opacity="0.2"/>
      <circle cx="512" cy="384" r="200" fill="none" stroke="#a855f7" stroke-width="1" opacity="0.1" stroke-dasharray="10 5"/>
    
  </svg>