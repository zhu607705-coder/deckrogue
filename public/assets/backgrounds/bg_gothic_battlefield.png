<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 768">
    
      <defs>
        <pattern id="gothicPattern" patternUnits="userSpaceOnUse" width="40" height="40">
          <path d="M0 20 L20 0 L40 20 L20 40 Z" fill="none" stroke="#b91c1c" stroke-width="1" opacity="0.2"/>
        </pattern>
        <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:0.8"/>
          <stop offset="50%" style="stop-color:#0a0a0f;stop-opacity:1"/>
          <stop offset="100%" style="stop-color:#b91c1c;stop-opacity:0.6"/>
        </linearGradient>
        <filter id="bloodDrip">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5"/>
        </filter>
      </defs>
      <rect width="1024" height="768" fill="url(#bgGrad)"/>
      <rect width="1024" height="768" fill="url(#gothicPattern)"/>
      <circle cx="100" cy="100" r="30" fill="#dc2626" opacity="0.1"/>
      <circle cx="900" cy="650" r="50" fill="#dc2626" opacity="0.08"/>
      <path d="M0 700 Q256 650 512 700 T1024 700 L1024 768 L0 768 Z" fill="#b91c1c" opacity="0.3"/>
    
  </svg>